# Copy to .env (next to docker-compose.yml) and fill in.

# The console's address. Its DNS A/AAAA record must point at this server
# before the first start, so Caddy can get a certificate.
KFS_DOMAIN=vault.example.com

# Output of: docker compose run --rm kryptonfs hash-password
# Keep the single quotes: the hash contains $ signs.
KFS_WEB_PASSWORD_HASH=''

# Largest upload, in MB (Caddy's limit in Caddyfile is 300 MB).
KFS_WEB_MAX_UPLOAD_MB=256
